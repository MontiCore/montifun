/* (c) https://github.com/MontiCore/monticore */
package de.monticore;
/* Alpha-version: This is intended to become a MontiCore stable grammar. */

//https://www.haskell.org/onlinereport/haskell2010/haskellch10.html#x17-17500010
//https://github.com/Frege/frege/blob/master/frege/compiler/grammar/Grammar.ebnf

//do: better builder, do not cascade
//do: builder -> no new, get it from Mill
//do: better names in grammar
//do: remove unneeded parts of grammar (a lot)
//do: re-integrate expressions
//do: do not convert every other thing to infix
//do: overwrite name (smallName or BigName?)
//do: add Java like syntax option to define functions (and to call functions?
//    -> do we differentiate between call and tuples then? We probably do not need tuples anyway

grammar MontiFun extends
                    de.monticore.MCBasics,
					//de.monticore.literals.MCCommonLiterals,
					de.monticore.literals.MCJavaLiterals
                    //de.monticore.statements.MCCommonStatements,
                    //de.monticore.statements.MCReturnStatements,
					//de.monticore.types.MCBasicTypes,
                    //de.monticore.types.MCSimpleGenericTypes
                    {
  start MF_module;

  scope symbol MF_module /*implements Diagram*/ =
    //these break because of Name vs MFSmallName...
    //MCPackageDeclaration?
    //MCImportStatement*
    "module" MF_modid ("(" (MF_export || ",")* ")")? "where" "{" MF_body "}"
    | MF_body
    ;
  symbolrule MF_module = functions:MFFun*;

  MF_body = MF_impdecl* MF_topdecl+;

  //no impspec
  MF_impdecl = "import" (qualified:"qualified")? module:MF_modid ("as" alias:MF_modid)? ";";

  MF_export =
      MF_qvar
    | MF_qtycon (dots:"(..)" | "(" (MF_cname || ",")* ")")?
    | MF_qtycls (dots:"(..)" | "(" (MF_qvar || ",")* ")")?
    | "module" MF_modid
  ;


  //split into sub-parts
  // put ";" after decls and "{}" for where/let? newline might be enough for decls
  //most of Haskell-topdecl is not implemented
  MF_topdecl =
    MF_decl ";"//MFDeclTopDecl
  ;
	
	//MFTypeTopDecl = "type" MF_sympletype "=" MF_type;
	//MFDataTopDecl = "data" (MF_context "=>")? MF_sympletype ("=" MF_constrs)? (MF_deriving)?;
	//MFNewTypeTopDecl = "newtype" (MF_context "=>")? MF_sympletype "=" MF_newconstr (MF_deriving)?;
	//MFClassTopDecl = "class" (MF_scontext "=>")? MF_tycls MF_tyvar ("where" MF_cdecls)?;
	//MFInstanceTopDecl = "instance" (MF_scontext "=>")? MF_qtycls MF_inst ("where" MF_idecls)?;
	//MFDefaultTopDecl = "default" "(" (MF_type || ",")* ")";
	//MFForeignTopDecl = "foreign" MF_fdecl;
	//MFDeclTopDecl = MF_decl;
	
	
	abstract scope MF_decl;
	MFGenDecl extends MF_decl = MF_gendecl;
	MFFunDecl extends MF_decl = MF_funlhs MF_rhs;
	MFPatDecl extends MF_decl = MF_pat MF_rhs;
	
	abstract MF_funlhs;
	astrule MF_funlhs = functionName: java.lang.String;
	MFPrefixFunLhs extends MF_funlhs = MF_var MF_apat+;
	MFInfixFunLhs  extends MF_funlhs = MF_pat MF_varop MF_pat;
	//not supported (yet?) // what does it do?
	MFMultiFunLhs  extends MF_funlhs = "(" MF_funlhs ")" MF_apat+;
	
	MF_rhs = ("=" MF_exp | MF_gdrhs) ("where" where:MF_decl+)?;
	MF_gdrhs = ("|" (MF_guard || ",")+)? "=" MF_exp MF_gdrhs?;
	MF_guard = 
	  /*  MFPatternGuard
	  | MFLocalDeclarationGuard
	  |*/ MFBooleanGuard
	;
	MFPatternGuard = MF_pat "<-" MF_infixexp;
	MFLocalDeclarationGuard = "let" MF_decl+;
	MFBooleanGuard = MF_infixexp;
	MF_exp /*implements Expression*/ =
	    //MFExpressionTypeSignature
	   MF_infixexp ("::" (MF_context "=>")? MF_type)?
	;
    MFExpressionTypeSignature /*implements Expression*/ = MF_infixexp "::" (MF_context "=>")? MF_type;
	
	MF_infixexp =
	    MFPrefixNegatedInfixExpression
	  | MFInfixOperatorApplication
	  | MF_lexp
	;
	MFInfixOperatorApplication = MF_lexp MF_qop MF_infixexp;
	//why doesn't this ever get hit?:
	MFPrefixNegatedInfixExpression = MFMinus MF_infixexp;


	//left? expression
	//nearly nothing is implemented
	//no let-in, if-then-else, do
	MF_lexp =
	    MFLambdaAbstraction
	  | MFCaseExpression
	  | MF_fexp
	;

	MFLambdaAbstraction = "\\" MF_apat+ "->" MF_exp;
	MFCaseExpression = "case" MF_exp "of" "{" (MF_alt || ";")+ ";"? "}";

    //not fully implemented:
	MF_alt = MF_pat "->" MF_exp;

	//function application
	//official grammar is left recursive (and left associative):
	//MF_fexp = MF_fexp? MF_aexp;
	MF_fexp = MF_aexp+;
	
	//atomic? expression
	//a lot not implemented
	//no arithmetic sequence, list comprehension, lables
	MF_aexp = 
	    MF_qvar
	  | MF_gcon
	  | MF_literal
	  | "(" MF_exp ")"
	  | MFTupleExpression
	  | MFListExpression
	  | MFInfixLeftSectionExpression
	  | MFInfixRightSectionExpression
	;
	MFTupleExpression = "(" (MF_exp || ",")+ ")";
	astrule MFTupleExpression = MF_exp min=2 max=*;
	MFListExpression = "[" (MF_exp || ",")+ "]";
	MFInfixLeftSectionExpression = "(" MF_infixexp MF_qop ")";
	//qop may not contain "-"... how to enforce?
	MFInfixRightSectionExpression = "(" MF_qop MF_infixexp ")";

	MF_gendecl =
	    MFTypeSignatureGenDecl
	  | MFFixityDecl
    ;

	//defines multiple symbols, e.g. "a,b::Bool"
	MFTypeSignatureGenDecl = (MFSVar || ",")+ "::" (MF_context "=>")? MF_type;
    enum OP_ASSOCIATIVITY =
        NONE:"infix"
      | LEFT:"infixl"
      | RIGHT:"infixr"
    ;
    MFFixity = associativity:OP_ASSOCIATIVITY precedence:MF_integer;
	MFFixityDecl = MFFixity (MF_op || ",")+ ;

	//types
	MF_type = MF_atype+ ("->" MF_type)?;
	
	//type application
	MF_atype = 
	    MF_gtycon
	  | MF_tyvar
	  | MFTupleType
	  | MFListType
	  | "(" MF_type ")"
	;
	
	MFTupleType = "(" (MF_type || ",")+ ")";
	astrule MFTupleType = MF_type min=2 max=*;
	
	MFListType = "[" MF_type "]";
	
	//general type constructor
	MF_gtycon = 
	    MF_qtycon
      | predefinedConstructor:MFPREDEFINEDCONSTRUCTOR
	  | MFTuplingConstructor
	;

	MF_context = MF_class | "(" (MF_class || ",")* ")";
	MF_class = MF_qtycls (MF_tyvar | "(" MF_tyvar MF_atype+ ")");
	//simple context
	MF_scontext = MF_simpleclass | "(" (MF_simpleclass || ",")* ")";
	MF_simpleclass = MF_qtycls MF_tyvar;
	
	//general constructor
	MF_gcon = 
	    predefinedConstructor:MFPREDEFINEDCONSTRUCTOR
	  | MF_qcon
	;

	enum MFPREDEFINEDCONSTRUCTOR =
	    EMPTYTUPLE:"()"
	  | EMPTYLIST:"[]"
	  | FUNCTION:"(->)"
	;
	
	MFTuplingConstructor = "(" comma:","+ ")" ;
	
	
	//patterns
	//removed lpat in between pat and apat (simplifying BNF to EBNF)
	MF_pat = 
	    //MFInfixConstructorPattern
		<rightassoc> left:MF_pat MF_qconop right:MF_pat
	  |	MFPrefixConstrutorPattern
	  | MFNegativeNumber
	  | MF_apat
	;
	//MFInfixConstructorPattern = <rightassoc> left:MF_pat MF_qconop right:MF_pat;
	MFPrefixConstrutorPattern = MF_gcon MF_apat+;

	//basically all patterns, but most constructors need parenthesis
	MF_apat = 
	    MF_var
	  | MFAsPattern
	  | MF_gcon // constructor with arity 0
	  | MF_wildcard
	  | MF_literal
	  | "(" MF_pat ")"
	  | MFTuplePattern
	  | MFListPattern
	  //| MFIrrefutablePattern
	;
	MFAsPattern = MF_var "@" MF_apat;
    MFTuplePattern = "(" (MF_pat || ",")+ ")";
	astrule MFTuplePattern = MF_pat min=2 max=*;
	MFListPattern = "[" (MF_pat || ",")+ "]";
	//MFIrrefutablePattern = "~" MF_apat; // basically a lazy pattern
	
	MF_wildcard = "_";

	
	//rather atomic identifiers:
	//variable
	MF_var = MF_varid | "(" MF_varsym ")";
	//variable as a symbol
	symbol MFSVar = MF_var;
	//qualified variable
	MF_qvar = MF_qvarid | "(" MF_qvarsym ")";
	//constructor
	MF_con = MF_conid | "(" MF_consym ")";
	//qualified constructor
	MF_qcon = MF_qconid | "(" MF_qconsym ")";
	//variable operator
	MF_varop = MF_varsym | "`" MF_varid "`" ;
	//qualified variable operator
	MF_qvarop = MF_qvarsym | "`" MF_qvarid "`";
	//constructor operator
	MF_conop = MF_consym | MF_conid;
    //qualified constructor operator
	MF_qconop = MF_qconsym | MF_qconid;
	//?
	MF_cname = MF_var | MF_con;


	//operator
	MF_op = MF_varop | MF_conop;
	//qualified operator
	MF_qop = MF_qvarop | MF_qconop;
	//general constructor symbol
	MF_gconsym = colon:":" | MF_qconsym;
	
	
	
	//tokens:
	
	//identifiers:
	//MF(Q)Name is used in e.g. interfaces
	MFName =
	    MFSmallName
	  | MFLargeName
	  | MF_varsym
	  | MF_consym
	;
	MFQName =
	    MFQSmallName
	  | MFQLargeName
	  | MF_qvarsym
      | MF_qconsym
    ;
    // '`' removed -> or else it doesn't understand "`plus`" as a varop...
	token MFSmallName = MF_small(MF_small | MF_large | MF_digit /*| '`'*/)*;
	token MFLargeName = MF_large(MF_small | MF_large | MF_digit /*| '`'*/)*;
	//variable
	MF_varid = MFSmallName;
	//constructor
	MF_conid = MFLargeName;
	//type variable
	MF_tyvar = MFSmallName; //MF_varid;
	//type constructor
	MF_tycon = MFLargeName;//MF_conid;
	//type class
	MF_tycls = MFLargeName;//MF_conid;
	//module
	MF_modid = (MFLargeName || ".")+;//(MF_conid '.')* MF_conid;
	
	//qualified identifiers:
	MFQSmallName = (MF_modid ".")? MFSmallName;
    MFQLargeName = (MF_modid ".")? MFLargeName;
	MF_qvarid = MFQSmallName;//(MF_modid '.')? MF_varid;
    MF_qconid = MFQLargeName;//(MF_modid '.')? MF_conid;
    MF_qtycon = MFQLargeName;//(MF_modid '.')? MF_tycon;
    MF_qtycls = MFQLargeName;//(MF_modid '.')? MF_tycls;
    MF_qvarsym = (MF_modid ".")? MF_varsym;
    MF_qconsym = (MF_modid ".")? MF_consym;
	
	//symbols
	//todo any way to exclude certain combinations?
	// both may not contain .. | : | :: | =  | | | <- | -> |  @ | ~ | =>
	//and varsym may not contain dashes ('-''-'+)
	token MFTVarsym = MFSymbolWithoutCollon MF_symbol*;
	token MFTConsym = ':' MF_symbol;
	MF_varsym = MFTVarsym;
	MF_consym = MFTConsym;
	
	//literals
	//in haskell they seem to be part of the lexer?
	MF_literal implements Literal = 
	    MF_integer
      | MF_float
	  | MF_char
	  | MF_string
	;
	MF_integer implements Literal = MFInteger;
	token MFInteger = Num_Int :
	  x -> int : {return Integer.parseInt(x.getText());}
	;
	MF_float implements Literal = Num_Float;
	MF_char implements Literal = Char;
	MF_string implements Literal = String;
	//if I understood it corrrectly, Num_Int, etc. isn't signed?
	MFNegativeNumber = MFMinus (MF_integer | MF_float);

	
	//some fragments
	fragment token MF_small = 'a'..'z';
	fragment token MF_large = 'A'..'Z';
	fragment token MF_digit = '0'..'9';
	token MFMinus = '-';
	fragment token MFSymbolWithoutCollonMinus = '!' | '#' | '$' | '%' | '&' | '*' | '+' | '.' | '/' | '<' | '=' | '>' | '?' | '@' | '\\' | '^' | '|' | '~';
	fragment token MFSymbolWithoutCollon = MFSymbolWithoutCollonMinus | MFMinus;
	fragment token MF_symbol = MFSymbolWithoutCollon | ':';
	
	
    /** A single line comment in Haskell style: --
        Comments are ignored by the parser.
    */
  token MF_SL_COMMENT =
  "--" (~('\n' | '\r' ))* : ->skip
      {storeComment();};

  /** A multi line comment in Haskell style.
      The comments are not nested.
      Comments are ignored by the parser.
  */
  token MF_ML_COMMENT =
  "{-" .*? "-}"  : -> skip
  {storeComment();};

  //symbol MFFun implements Function =
  //  MCReturnType Name "(" (FormalParameter || ",")* ")" MCJavaBlock;

  symbol MFFun;
  symbolrule MFFun =
      //name:java.lang.String
      typeSignature:MFTypeSignatureGenDecl
      fixity:MFFixity?
      //funDecls:MFFunDecl*
      //patDecl:MFPatDecl?
  ;
  astrule MFFun =
  //added the name here so that it will be stored in symbol table...
  //there ought to be a better way
    name:java.lang.String
    //fixity:
    funDecls:MFFunDecl*
    patDecl:MFPatDecl? //MFPatdecl could be "foo = bar", not part of funDecl
  ;
  //symbolrule MFFun =
    //fixity:int? //not implemented, also fixity has an enum as well
   // typeSignature:MFTypeSignatureGenDecl
  //;

}
