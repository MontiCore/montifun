package de.monticore.mf;

import de.monticore.expressions.ExpressionsBasis;

/* Alpha-version: This is intended to become a MontiCore stable grammar. */

component grammar MFCallExpressions extends ExpressionsBasis {

  /*
   * Like CallExpression, but it allows for anonymous functions,
   * e.g. foo()(), a[1]() or lambdas
   * as such no function name might be providable
   * priority is higher than the one of CallExpression (240)
   */
    NamelessCallExpression implements Expression <250> =
      Expression Arguments;

}
