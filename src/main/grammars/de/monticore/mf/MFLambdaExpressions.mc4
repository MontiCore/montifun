package de.monticore.mf;

import de.monticore.expressions.ExpressionsBasis;
import de.monticore.types.MCBasicTypes;

/* Alpha-version: This is intended to become a MontiCore stable grammar. */
//todo, later, when TypeCheck & SymTab Repräsentation dafür geklärt ist:  move to MC

component grammar MFLambdaExpressions extends ExpressionsBasis,
                                              MCBasicTypes {

  LambdaParameter = MCType? Name;

  LambdaParameters =
    LambdaParameter
    | parenthesis:"(" (LambdaParameter || ",")* ")"
  ;

  //todo priority?  Welche Prio halten wir für sinnvoll. Was macht zB Java?
  LambdaExpression implements Expression =
    <rightassoc>
    LambdaParameters "->"
    Expression
  ;
}
