/* (c) https://github.com/MontiCore/monticore */
package de.monticore.mf;

import de.monticore.ocl.*;
import de.monticore.expressions.*;
import de.monticore.siunit.*;
import de.monticore.types.*;
import de.monticore.literals.MCCommonLiterals;
import de.monticore.regex.RegExType;
import de.monticore.symbols.OOSymbols;

/* Alpha-version: This is intended to become a MontiCore stable grammar. */

grammar MontiFun extends
                   // literals
                   MCCommonLiterals,
                   SIUnitLiterals,
                   // expressions
                   BitExpressions,
                   OCLExpressions,
                   OptionalOperators,
                   LambdaExpressions,
                   SetExpressions,
                   StreamExpressions,
                   TupleExpressions,
                   UglyExpressions,
                   // types
                   MCArrayTypes,
                   MCFunctionTypes,
                   MCSimpleGenericTypes,
                   MCStructuralTypes,
                   RegExType,
                   SIUnitTypes4Computing,
                   SIUnitTypes4Math,
                   TypeParameters,
                   // symbols
                   OOSymbols {
  
  /**
   *  ASTMFCompilationUnit represents the entire content of an MF model
   *    @attribute package
   *               The package declaration of the component model
   *    @attribute MCImportStatement
   *               List of imported elements
   *    @attribute MFArtifact
   *               wrapper for the montifun statements
   */
  MFCompilationUnit =
    MCPackageDeclaration?
    MCImportStatement*
    MFArtifact
  ;
  
  /**
   * ASTMFArtifact represents a file that contains MF-statements.
   *   @attribute Name
   *              Name of MFFile (necessary for MCCompilationUnit)
   *   @attribute MFConstraint
   *              List of MF-constraints.
   */
  MFArtifact implements Diagram =
    "montifun" Name "{"
      (MFFunctionDeclaration | MFConstantDeclaration)*
    "}"
  ;

  /** 
   * ASTMFParameter describes how function parameters are defined:
   * The use of an explicit type is optional, because MontiFun attempts to
   * derive the arguments type implicitly
   * (in the Spirit of other functional languages, like Haskell)
   *
   * However, from a Software Engineering Point of view, making the
   * type explicit is a kind of quality check and thus often useful.
   */
  MFParameter implements Variable =
    MCType? Name
  ;


  /**
   * ASTMFFunctionDeclaration describes a first way of defining functions.
   * Generic functions are declared by providing type parameters.
   *
   * Examples:   int foo(int a, String b) = ...
   *             <T> List<T> bar(T t) = ...
   *
   * This nonterminal introduces FunctionSymbols.
   */
  MFFunctionDeclaration implements Function =
    TypeParameters?
    MCReturnType? Name
    "(" (MFParameter || ",")* ")"
    "=" Expression ";"
  ;


  /**
   * ASTMFConstantDeclaration describes a first way of defining constants.
   *
   * Examples:   double foo = ...
   *
   * This nonterminal introduces VariableSymbols.
   */
  MFConstantDeclaration implements Variable =
    MCType? Name
    "=" Expression ";"
  ;

}
