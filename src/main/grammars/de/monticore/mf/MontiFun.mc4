package de.monticore.mf;

import de.monticore.literals.MCCommonLiterals;
import de.monticore.types.MCSimpleGenericTypes;
import de.monticore.statements.MCCommonStatements;
import de.monticore.symbols.BasicSymbols;

/* Alpha-version: This is intended to become a MontiCore stable grammar. */

grammar MF extends MCCommonLiterals,
                   MCSimpleGenericTypes,
                   MFExpressions,
                   MCCommonStatements,
                   BasicSymbols {
  
    /**
   *  ASTMFCompilationUnit represents the entire content of an MF model
   *    @attribute package
   *               The package declaration of the component model
   *    @attribute MCImportStatement
   *               List of imported elements
   *    @attribute MFArtifact
   *               wrapper for the montifun statements
   */
  MFCompilationUnit =
    MCPackageDeclaration?
    MCImportStatement*
    MFArtifact
  ;
  
  /**
   * ASTMFArtifact represents a file that contains MF-statements.
   *   @attribute Name
   *              Name of MFFile (necessary for MCCompilationUnit)
   *   @attribute MFConstraint
   *              List of MF-constraints.
   */
  MFArtifact implements Diagram =
    "montifun" Name "{"
      MFFunctionDeclaration*
    "}"
  ;

  MFParameter =
    MCType? Name
  ;


  MFFunctionDeclaration implements Function =
    MCReturnType? Name
    (parenthesis:"(" (MFParameter || ",")* ")")?
    "=" Expression ";"
  ;

}
