-- fib calculates the n'th fibonacci number
fib :: Int -> Int;
fib 0 = 0;
fib 1 = 1;
fib n = fib (n - 1) + fib ((-) n  2);

fib2 :: (->) Int Int;
fib2 = fib;

a + b = b + a;

first :: Int -> Int -> Int;
first a b = a;
infixl 2 `first`;
test a b = (+ b) a*2+3-4+5*3+3-((a^b -) a);
--test a b = - a; --breaks, why
test a b = (1+2*3) == 1++2*(2==4);
-- https://www.haskell.org/onlinereport/decls.html#prelude-fixities
infixr 8 ^;
infixl 7 *, /;
infixl 6 +, -;
infixr 5 ++;
infix  4 ==;
(^), (*), (/), (+), (-), (==), (++) :: Int -> Int;